<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SimdPhrase2.ComparativeBench</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      This project deliberately references BOTH the SimdPhrase2 library
      (project reference, namespace root `SimdPhrase2.*`) and the legacy
      Lucene.NET 4.8 packages (namespace root `Lucene.Net.*`). The legacy
      packages are not AOT/trim clean and ship no XML docs, so opt out of
      those analyzers here.
    -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <!-- The SimdPhrase2 library (SimdPhrase2.* namespaces). -->
  <ItemGroup>
    <ProjectReference Include="..\SimdPhrase2\SimdPhrase2.csproj" />
  </ItemGroup>

  <!-- The legacy Lucene.NET 4.8 packages (Lucene.Net.* namespaces). -->
  <ItemGroup>
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
    <PackageReference Include="Lucene.Net.Facet" Version="4.8.0-beta00017" />
  </ItemGroup>

</Project>
